package main

import (
	"fmt"
	"sync"
)

func main() {
	jobs := make(chan int, 10)
	var wg sync.WaitGroup
	
	var resultsMu sync.Mutex
	results := make(map[int]int)

	for w := 1; w <= 3; w++ {
		wg.Add(1)
		go func(workerID int) {
			defer wg.Done()
			for job := range jobs {
				res := job * 2 // Какая-то работа
				
				resultsMu.Lock()
				results[job] = res
				resultsMu.Unlock()
			}
		}(w)
	}

	for i := 1; i <= 10; i++ {
		jobs <- i
	}
	close(jobs)
	
	wg.Wait()
	fmt.Println("Результаты:", results)
}
